# Supabase — fill these in once the project is created.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth — configured in Supabase Auth → Providers → Google.
# (Client ID/secret live in the Supabase dashboard, not here.)
#
# OAuth redirect URLs are built from window.location.origin in the browser,
# so no NEXT_PUBLIC_SITE_URL is needed in env. Make sure each origin you
# deploy to is on Supabase Auth → URL Configuration → Additional Redirect URLs.
