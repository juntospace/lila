# Supabase — fill these in once the project is created.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth — configure in Supabase Auth → Providers → Google.
# (Client ID/secret live in the Supabase dashboard, not here.)

# Site URL — used to build OAuth redirect URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
